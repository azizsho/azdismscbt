# ── Discord application ────────────────────────────────────────────────────────
# Developer Portal → your app → Bot → Reset Token. Never share this token.
DISCORD_TOKEN=your_bot_token_here

# Developer Portal → General Information → Application ID.
DISCORD_CLIENT_ID=your_application_id_here

# Optional but recommended while setting up: your server ID. Guild commands
# appear instantly. Leave blank to register global commands (up to 1 hour).
DISCORD_GUILD_ID=

# ── Access control (optional) ─────────────────────────────────────────────────
# Comma-separated role IDs allowed to use destructive controls (stop, skip,
# volume, seek, shuffle, clear, etc.). Leave blank to let everyone use them.
# Members with Manage Server always have DJ access.
DJ_ROLE_IDS=

# If set, the bot only responds in these text channel IDs (comma-separated).
ALLOWED_TEXT_CHANNEL_IDS=

# ── Playback defaults ─────────────────────────────────────────────────────────
# 100 keeps the bit-exact Opus passthrough. Any other value forces ffmpeg to
# decode and re-encode the audio (and can sound slightly different).
DEFAULT_VOLUME=100
MAX_QUEUE_SIZE=100
MAX_TRACK_MINUTES=120
MAX_PLAYLIST_ITEMS=50
IDLE_DISCONNECT_SECONDS=300

# 256 is a good maximum. Discord's real cap depends on the server boost tier:
# no boosts 96, tier 1 128, tier 2 256, tier 3 384 kbps.
# Values are rounded to the nearest 8 kbps (Discord's bitrate step).
MAX_BITRATE_KBPS=256
AUTO_SET_CHANNEL_BITRATE=true

# Download upcoming queue tracks in the background, next track first, so the
# next songs are already on disk before the current one ends. 0 disables it.
PRELOAD_AHEAD=3
PRELOAD_CONCURRENCY=2

# Restore the voice channel's original bitrate when the bot leaves, but only if
# nobody changed it after the bot raised it.
RESTORE_CHANNEL_BITRATE=true

# Pause while the bot is alone in the voice channel, and leave after this many
# seconds alone. 0 disables the leave timer.
PAUSE_WHEN_ALONE=true
LEAVE_WHEN_ALONE_SECONDS=120

# When the queue empties, append related tracks from the YouTube mix of the
# last track. This is the default for servers that never ran /autoplay; the
# command stores a per-server override. AUTOPLAY_ADD is how many tracks to add
# per fetch.
AUTOPLAY=false
AUTOPLAY_ADD=5

# Cap concurrent yt-dlp processes and add a per-user cooldown to /play and
# /search so one person cannot flood the queue.
YTDLP_CONCURRENCY=4
COMMAND_COOLDOWN_SECONDS=2

# Warn at startup when the installed yt-dlp is older than this many days.
YTDLP_MAX_AGE_DAYS=45

# Maximum time to spend downloading one track. Raise this on slow connections.
YTDLP_DOWNLOAD_TIMEOUT_MINUTES=30

# Optional single-pass loudness normalization. Off by default because it can
# slightly colour the audio; turn on if source volumes vary a lot.
AUDIO_NORMALIZE=false

AUTO_DEPLOY_COMMANDS=true
NOW_PLAYING_MESSAGES=true

# Optional short clips played when the bot joins/leaves voice. Leave blank to
# disable. Any format ffmpeg supports works (mp3, ogg, wav, ...). Paths are
# relative to this folder unless absolute.
JOIN_SOUND_FILE=
LEAVE_SOUND_FILE=
SOUND_VOLUME=100
SOUND_MAX_SECONDS=5

# ── YouTube authentication (optional, recommended) ────────────────────────────
# Netscape-format cookies.txt exported from a browser where you are signed in
# to YouTube. Use a dedicated account. Needed for age-restricted videos and if
# YouTube asks the host to "confirm you're not a bot". Premium cookies may also
# expose higher-bitrate audio formats.
# YOUTUBE_COOKIES_FILE=./data/cookies.txt
YOUTUBE_COOKIES_FILE=

# ── Files and tools ───────────────────────────────────────────────────────────
AUDIO_CACHE_MAX_MB=2048
DATA_DIR=./data
# Optional overrides; leave blank to use the defaults under DATA_DIR.
AUDIO_CACHE_DIR=
TEMP_DIR=
YTDLP_CACHE_DIR=

# Leave blank to use the bundled ffmpeg-static binary and tools/yt-dlp.
FFMPEG_PATH=
YTDLP_PATH=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
EMBED_COLOR=#5865F2
