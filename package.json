{
  "name": "discord-youtube-music-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted Discord music bot that streams high-quality audio from YouTube.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "headless": "powershell -ExecutionPolicy Bypass -File scripts/start-bot.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-bot.ps1",
    "restart": "powershell -ExecutionPolicy Bypass -File scripts/restart-bot.ps1",
    "status": "powershell -ExecutionPolicy Bypass -File scripts/status-bot.ps1",
    "deploy": "node scripts/deploy-commands.mjs",
    "setup": "node scripts/setup.mjs",
    "update-tools": "node scripts/setup.mjs --force",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src scripts test",
    "service:install": "powershell -ExecutionPolicy Bypass -File scripts/install-windows-task.ps1",
    "service:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-windows-task.ps1"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "typescript": "^7.0.2"
  }
}
